[Unit]
Description=osu! idle Discord bot (level roles)
After=network.target mariadb.service redis-server.service
Wants=mariadb.service redis-server.service

[Service]
Type=simple
User=adri
# Runs from the prod checkout, like the API (see scripts/prod-build.mjs).
WorkingDirectory=/main/osu/idle-prod/packages/discord
Environment=NODE_ENV=production
Environment="PATH=/home/adri/.nvm/versions/node/v22.13.0/bin:/usr/local/bin:/usr/bin:/bin"
# A single process: two bots would fight over the same roles.
ExecStart=/home/adri/.nvm/versions/node/v22.13.0/bin/node --import tsx src/index.ts
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=osu-idle-discord

[Install]
WantedBy=multi-user.target
