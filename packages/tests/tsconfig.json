{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["node"],
    // Mirror the vitest aliases so `tsc` typechecks against their source too.
    "paths": {
      "@oss-idle/shared/*": ["../shared/src/*"],
      "@oss-idle/client/*": ["../client/src/*"]
    }
  },
  "include": ["src", "vitest.config.ts"]
}
